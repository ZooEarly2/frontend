# 게이트웨이(Spring) 오리진. 경로 접두어는 아래 값이 따로 붙이므로 여기 넣지 않는다.
#   로컬  : http://localhost:8080
#   Azure : https://<your-container-app>.azurecontainerapps.io
VITE_API_BASE_URL=http://localhost:8080

# 모든 엔드포인트 앞에 붙는 접두어. 게이트웨이는 /api/v1/ai/* 로 노출한다.
VITE_API_PREFIX=/api/v1

# 서버 TTS 가 목(mock) 음성일 때 브라우저 음성합성으로 대신 읽어줄지.
#   auto   : 목이면 브라우저로 읽고, 실제 음성이면 서버 음성을 재생한다 (기본)
#   server : 항상 서버 음성만 재생한다
#   browser: 서버를 부르지 않고 브라우저 음성만 쓴다 (백엔드 없이 화면만 볼 때)
VITE_TTS_MODE=auto
